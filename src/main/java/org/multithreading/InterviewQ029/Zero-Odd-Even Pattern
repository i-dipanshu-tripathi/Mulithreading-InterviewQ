package zeroevenodd;


public class Main {


    public static void main(String[] args) {


        SharedResource sharedResource =
                new SharedResource(1, 20);


        Runnable zeroRunnable = () -> {
            try {
                sharedResource.printZero();
            } catch (Exception e) {
                e.printStackTrace();
            }
        };


        Runnable evenOddRunnable = () -> {
            try {
                sharedResource.printEvenOdd();
            } catch (InterruptedException e) {
                e.printStackTrace();
            }
        };


        Thread zeroThread =
                new Thread(zeroRunnable, "Zero-Thread");


        Thread evenOddThread =
                new Thread(evenOddRunnable, "Even-Odd-Thread");


        zeroThread.start();
        evenOddThread.start();
    }
}
